# ============================================================
#  VILLA R.E.E.L — Variables d'environnement
#  Copier ce fichier en .env et renseigner chaque valeur
# ============================================================

# ── Base de données ──────────────────────────────────────────
# PostgreSQL (Docker Compose ou hébergeur comme Supabase / Railway)
DATABASE_URL="postgresql://villa_reel:CHANGE_ME@localhost:5432/villa_reel"

# ── NextAuth ─────────────────────────────────────────────────
# Générer avec : openssl rand -base64 32
NEXTAUTH_SECRET="CHANGE_ME_openssl_rand_base64_32"
# URL publique de l'application (sans slash final)
NEXTAUTH_URL="https://villareel.com"

# ── Stripe ───────────────────────────────────────────────────
# Clé secrète (commence par sk_live_ ou sk_test_)
STRIPE_SK="sk_test_CHANGE_ME"
# Clé publique (commence par pk_live_ ou pk_test_)
NEXT_PUBLIC_STRIPE_PK="pk_test_CHANGE_ME"
# Secret du webhook Stripe (obtenu dans le Dashboard Stripe → Webhooks)
STRIPE_WEBHOOK_SECRET="whsec_CHANGE_ME"

# ── Resend (emails transactionnels) ──────────────────────────
RESEND_API_KEY="re_CHANGE_ME"
# Adresse email de réception des messages de contact
CONTACT_EMAIL="contact@villareel.com"

# ── URL publique ─────────────────────────────────────────────
# Utilisée dans les liens des emails (sans slash final)
NEXT_PUBLIC_APP_URL="https://villareel.com"

# ── Environnement ─────────────────────────────────────────────
NODE_ENV="production"

# ── Sécurité CRON ─────────────────────────────────────────────
# Secret pour protéger l'endpoint /api/stripe/schedule-balance
# Générer avec : openssl rand -hex 32
CRON_SECRET="CHANGE_ME_openssl_rand_hex_32"

# ── Mode maintenance ───────────────────────────────────────────
# Mettre à "true" pour afficher la page de maintenance.
# Tout le trafic public est redirigé vers /maintenance.
# Les routes /api/* et /admin restent accessibles.
# ⚠️ Ne jamais oublier de repasser à "false" après intervention.
MAINTENANCE_MODE="false"

# ── Niveau de logs ─────────────────────────────────────────────
# "debug" pour voir tous les logs, laisser vide en production
LOG_LEVEL=""
